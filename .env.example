# ===================================================================
# CodeTlon Site — Variables de entorno
# ===================================================================
# Copiar a .env.local y completar. NUNCA committear .env.local.
# Dos entornos (ver docs/environments.md): dev → Vercel Preview · prod → Vercel Production.
# Sin base de datos: los formularios se envían por Resend.
# ===================================================================

# Resend — compartido entre entornos
RESEND_API_KEY=re_...
RESEND_FROM_NAME=CodeTlon
RESEND_FROM_EMAIL=onboarding@resend.dev

# Empresa — destinatario de los formularios (en dev conviene un mail de prueba)
COMPANY_EMAIL=info@codetlon.com.ar

# Google Analytics 4 — solo en prod (vacío en dev para no medir tráfico de prueba)
# Measurement ID — obtenerlo en analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Públicos — DISTINTO por entorno: NEXT_PUBLIC_SITE_URL apunta al dominio del entorno
NEXT_PUBLIC_WHATSAPP_NUMBER=+5493511234567
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/codetlon/
NEXT_PUBLIC_SITE_URL=https://codetlon.com
